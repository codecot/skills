      "\\bcomprehensive\\b",
      "\\binnovative\\b",
      "\\btransformative\\b",
      "\\bdynamic\\b",
      "\\bleverag\\w+",
      "\\bempower\\w+",
      "\\bcrucial\\b",
      "\\bvital\\b",
      "\\blandscape\\b",
